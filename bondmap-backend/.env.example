# HTTP port of the backend (host and container mapping)
PORT=8080

# PostgreSQL (backing service)
# IMPORTANT: password is applied only on first DB init.
# If you change it later, reset volume: docker compose down -v
POSTGRES_DB=bondmap
POSTGRES_USER=bondmap
POSTGRES_PASSWORD=bondmap_password
POSTGRES_PORT=5432

# Used when running the app outside Docker (./gradlew bootRun)
DATABASE_URL=jdbc:postgresql://localhost:5432/bondmap
DATABASE_USERNAME=bondmap
DATABASE_PASSWORD=bondmap_password
